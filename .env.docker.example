# Zkopíruj jako .env.docker a doplň skutečné hodnoty.
# Tenhle soubor NIKDY necommituj — .env.docker je v .gitignore.
#
# POZOR: klíče, které byly do teď natvrdo ve zdrojácích, jsou ve veřejné
# historii repozitáře. Než je sem vložíš, vygeneruj si na Golemiu a
# WeatherAPI nové a ty staré zneplatni.

# Golemio (PID) — čtyři sloty, klient posílá jen jméno slotu
GOLEMIO_KEY_1=
GOLEMIO_KEY_2=
GOLEMIO_KEY_3=
GOLEMIO_KEY_PRAGENSIS=

# WeatherAPI
WEATHER_KEY=

# Meteostanice ve školní síti
METEO_UPSTREAM=http://10.0.10.208

# Odkud brát výluky (Vercel funkce api/pid-alerts.ts)
ALERTS_UPSTREAM=https://timetable.brozovec.eu
