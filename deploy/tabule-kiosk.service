[Unit]
Description=SPSD tabule - Chromium kiosk
After=graphical.target tabule-web.service
Wants=tabule-web.service

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
# URL se generuje pri instalaci (install.sh), vcetne routy
EnvironmentFile=/etc/default/tabule

# Vypnout uspavani obrazovky - jinak to po hodinach zcerna a vypada to jako pad
ExecStartPre=-/usr/bin/xset s off
ExecStartPre=-/usr/bin/xset -dpms
ExecStartPre=-/usr/bin/xset s noblank
# Chromium si po tvrdem padu pamatuje "crashed" stav a pri startu ukaze dialog
ExecStartPre=-/bin/sh -c "sed -i 's/\"exit_type\":\"Crashed\"/\"exit_type\":\"Normal\"/; s/\"exited_cleanly\":false/\"exited_cleanly\":true/' /home/pi/.config/chromium/Default/Preferences 2>/dev/null || true"

ExecStart=/usr/bin/chromium-browser \
  --kiosk \
  --app=${TABULE_URL} \
  --user-data-dir=/home/pi/.config/chromium \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --no-first-run \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --remote-debugging-port=9222 \
  \
  `# ── GPU: ZAPNOUT, ne vypnout ──────────────────────────────────` \
  `# --disable-gpu by hodilo kompozici i canvas na CPU (SwiftShader).` \
  `# Na Pi je to nejhorsi mozna volba: VideoCore VI kompozici zvlada,` \
  `# Cortex-A72 ne. Vypinat GPU ma smysl jen kdyz ovladac pada.` \
  --use-gl=egl \
  --ignore-gpu-blocklist \
  --enable-gpu-rasterization \
  --enable-zero-copy \
  `# Kdyz GPU cesta selze, at to spadne viditelne misto tiche jizdy` \
  `# na software rendereru, ktera vypada jako "slaby hardware".` \
  --disable-software-rasterizer \
  \
  `# ── co se vyplati vypnout ─────────────────────────────────────` \
  `# Tabule nema zvuk, uzivatele, rozsireni ani druhou zalozku.` \
  --mute-audio \
  --disable-extensions \
  --disable-sync \
  --disable-background-networking \
  --disable-component-update \
  --check-for-update-interval=31536000 \
  --disable-translate \
  --disable-features=Translate,TranslateUI,MediaRouter,OptimizationHints,InterestFeedContentSuggestions \
  `# Jedna stranka = jeden renderer. Kazdy dalsi proces je na 1-2 GB znat.` \
  --renderer-process-limit=1 \
  \
  `# ── 24/7 provoz ───────────────────────────────────────────────` \
  `# Chromium jinak po case uspi casovace i v kiosku a odjezdy prestanou` \
  `# tikat; tabule pak ukazuje stara data, aniz by cokoli spadlo.` \
  --disable-background-timer-throttling \
  --disable-renderer-backgrounding \
  --disable-backgrounding-occluded-windows \
  `# Cache na SD kartu drz malou - opotrebeni a plny disk se projevi` \
  `# jako "zatuhnuti", ktere vypada jako chyba aplikace.` \
  --disk-cache-size=33554432 \
  --media-cache-size=1

Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
